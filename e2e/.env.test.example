# E2E test credentials for the scaffolded template project.
# Copy to .env.test and fill with values from a Bodhi dev/staging
# environment. CI reads these from GitHub vars/secrets instead.

# Bodhi server (booted by @bodhiapp/app-bindings in global-setup)
BODHIAPP_CLIENT_ID=
BODHIAPP_CLIENT_SECRET=
BODHIAPP_USERNAME=
BODHIAPP_USERID=
BODHIAPP_PASSWORD=
BODHIAPP_AUTH_URL=https://main-id.getbodhi.app
BODHIAPP_AUTH_REALM=bodhi

# Proxied OpenAI model used by the e2e chat test
OPENAI_API_KEY=

# Vite build-time env injected into the scaffolded app
VITE_BODHI_APP_CLIENT_ID=
VITE_BODHI_AUTH_SERVER_URL=
