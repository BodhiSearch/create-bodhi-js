# E2E test credentials for create-bodhi-js's bootstrap test.
# Copy to .env.test and fill in real values from a Bodhi dev/staging
# environment. CI reads these from GitHub vars/secrets instead.

# Bodhi Development Client ID (the app client scaffolded projects use;
# redirect configured for http://localhost:5173/<projectName>/callback)
DEV_CLIENT_ID=

# Bodhi server credentials (bootstrapped project boots its own bodhi server
# via @bodhiapp/app-bindings and logs in with these)
BODHIAPP_CLIENT_ID=
BODHIAPP_CLIENT_SECRET=
BODHIAPP_USERNAME=
BODHIAPP_USERID=
BODHIAPP_PASSWORD=
BODHIAPP_AUTH_URL=https://main-id.getbodhi.app
BODHIAPP_AUTH_REALM=bodhi

# Proxied OpenAI model used by the scaffolded e2e chat test
OPENAI_API_KEY=
